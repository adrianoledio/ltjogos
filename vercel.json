{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/webhook(.*)", "destination": "/api/index" },
    { "source": "/app/webhook(.*)", "destination": "/api/index" },
    { "source": "/((?!api|webhook|app/webhook).*)", "destination": "/index.html" }
  ]
}
